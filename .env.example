# Copie ce fichier en `.env` (à la racine du dépôt, ou à côté de PixelCity.exe).
# Le vrai `.env` est ignoré par Git : on n'y versionne jamais de secret.

# ollama (par défaut) ou off (répliques scriptées, sans IA)
PIXELCITY_LLM=ollama
OLLAMA_HOST=http://localhost:11434
# Modèle par défaut des habitants (un habitant peut avoir le sien dans agents.yaml).
# Installe-le avec : ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
# Secondes avant d'abandonner une réponse et de repasser au script
OLLAMA_TIMEOUT=30
